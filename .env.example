OPENROUTER_API_KEY=your-openrouter-api-key-here
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# LLM Retry Configuration (Optional)
MAX_LLM_RETRIES=3

# Feedback Generation Mode
# Options: single_model (default, uses OPENROUTER_MODEL) | multi_model (uses 3 different models)
FEEDBACK_MODE=single_model

# Multi-Model Feedback Configuration (used when FEEDBACK_MODE=multi_model)
# Evaluator models: Comma-separated list of models for independent evaluations (minimum 2)
FEEDBACK_EVALUATOR_MODELS=google/gemini-3-flash-preview,openai/gpt-5.2-chat
# Aggregator model: Single model that synthesizes all evaluator feedbacks
FEEDBACK_AGGREGATOR_MODEL=google/gemini-3-pro-preview

# Advanced Multi-Model Settings
# Save Models 1 & 2 outputs to interview logs (useful for debugging and analysis)
SAVE_INTERMEDIATE_FEEDBACK=true
# Fallback behavior when one model fails: partial (use successful one) | fail (raise error) | single_model (use default)
MULTIMODEL_FALLBACK_MODE=partial

# Langfuse (Optional - for tracing and observability)
LANGFUSE_PUBLIC_KEY=your-langfuse-public-key-here
LANGFUSE_SECRET_KEY=your-langfuse-secret-key-here
LANGFUSE_HOST=https://cloud.langfuse.com